    "Privacy-Policy.html": {
      "settings": {
        "title": "Privacy Policy",
        "order": "2",
        "meta_descr": "Read the Privacy Policy for it to learn how your data is collected, used, and protected with secure, transparent practices."
      },
      "components": [
        {
          "alias": false,
          "_styles": {
